// tests/chat.test.js
// Tests for the chatbot API.
//
// The chatbot internally calls localhost:5000/api/routes/buildings to look up
// buildings. In tests no server is running, so we mock (fake) that network call.

const request = require('supertest');
const express = require('express');

// Mock the global fetch so the chat route doesn't try to call localhost:5000
global.fetch = jest.fn(() =>
  Promise.resolve({
    json: () => Promise.resolve({ buildings: [] }),
  })
);

const chatRoutes = require('../routes/chat');

const app = express();
app.use(express.json());
app.use('/api/chat', chatRoutes);

beforeEach(() => { global.fetch.mockClear(); });

describe('POST /api/chat', () => {

  test('replies to a greeting', async () => {
    const res = await request(app).post('/api/chat').send({ message: 'hello' });
    expect(res.status).toBe(200);
    expect(typeof res.body.reply).toBe('string');
    expect(res.body.reply.length).toBeGreaterThan(0);
  });

  test('replies to a library question', async () => {
    const res = await request(app).post('/api/chat').send({ message: 'where is the library?' });
    expect(res.status).toBe(200);
    expect(res.body.reply.toLowerCase()).toContain('library');
  });

  test('replies to a food/cafeteria question', async () => {
    const res = await request(app).post('/api/chat').send({ message: 'where can I eat food?' });
    expect(res.status).toBe(200);
    expect(res.body.reply).toBeDefined();
  });

  test('replies to an admin office question', async () => {
    const res = await request(app).post('/api/chat').send({ message: 'where is the admin office?' });
    expect(res.status).toBe(200);
    expect(res.body.reply).toBeDefined();
  });

  test('handles an empty message without crashing', async () => {
    const res = await request(app).post('/api/chat').send({ message: '' });
    expect(res.status).toBe(200);
    expect(res.body.reply).toBeDefined();
  });

  test('handles a missing message field without crashing', async () => {
    const res = await request(app).post('/api/chat').send({});
    expect(res.status).toBe(200);
    expect(res.body.reply).toBeDefined();
  });

  test('gives a default reply for unrecognised messages', async () => {
    const res = await request(app).post('/api/chat').send({ message: 'xyzzy gibberish unknown' });
    expect(res.status).toBe(200);
    expect(res.body.reply.length).toBeGreaterThan(0);
  });

});